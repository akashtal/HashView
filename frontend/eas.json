{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.hashview.co.uk/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.hashview.co.uk",
        "EXPO_PUBLIC_API_TIMEOUT": "30000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.hashview.co.uk/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.hashview.co.uk",
        "EXPO_PUBLIC_API_TIMEOUT": "30000"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "distribution": "store",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.hashview.co.uk/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.hashview.co.uk",
        "EXPO_PUBLIC_API_TIMEOUT": "30000"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "hashview01@gmail.com",
        "ascAppId": "6756681321",
        "appleTeamId": "TJ77UDBJ4N"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}