{
  "name": "hashview-mobile",
  "version": "1.1.2",
  "description": "HashView Mobile App - React Native Expo",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:android": "npx eas build --platform android",
    "build:ios": "npx eas build --platform ios",
    "build:ios:preview": "npx eas build --platform ios --profile preview",
    "build:ios:production": "npx eas build --platform ios --profile production",
    "eas:login": "npx eas login",
    "eas:configure": "npx eas build:configure",
    "update": "npx eas update --branch production --message",
    "update:staging": "npx eas update --branch staging --message",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "postinstall": "patch-package || echo \"patch-package failed (no patches)\""
  },
